# Copia este archivo a .env.local y pon tus datos de Supabase
# (Settings -> API en tu proyecto de Supabase)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: dominio interno usado para convertir "usuario" en un email
# falso que Supabase Auth necesita internamente (nadie recibe correos).
# Si no lo defines, se usa "internal.local" por defecto.
VITE_AUTH_EMAIL_DOMAIN=internal.local
